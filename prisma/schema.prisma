// Nile Kings Online - Prisma schema
// Database: Neon Postgres
// Money: integer piastres (e.g. 19900 = 199 EGP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  PARTNER
}

enum OrderStatus {
  CREATED       // قيد الانشاء — unpaid InstaPay; stock held in stockReserved until admin confirms/cancels
  CONFIRMED     // مؤكد
  PROCESSING    // قيد التجهيز
  READY_TO_SHIP // جاهز للشحن — ready for courier export
  SHIPPED       // تم الشحن
  DELIVERED     // تم التسليم
  CANCELLED     // ملغي
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Auth & Users
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  phone          String    @unique
  passwordHash   String?   // set on register; required for password login
  name           String?
  email          String?
  role           UserRole  @default(CUSTOMER)
  seniorVerified Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  carts              Cart[]
  orders             Order[]
  couponUsages       CouponUsage[]
  savedAddresses     SavedAddress[]
  seniorVerification SeniorVerification?
  partner            Partner?
  orderTickets       OrderTicket[]

  @@index([phone])
  @@index([role])
}

// Egyptian national ID: stored encrypted; fingerprint prevents reuse across accounts
model SeniorVerification {
  id                    String   @id @default(cuid())
  userId                String   @unique
  nationalIdEncrypted   String   // AES-256
  nationalIdFingerprint String   @unique // SHA-256 of raw ID
  nationalIdLast4       String   // masked for display only
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nationalIdFingerprint])
}

// Key-value site settings (e.g. senior promo enabled)
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // e.g. "true" | "false"
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SavedAddress {
  id          String   @id @default(cuid())
  userId      String
  label       String?  // e.g. "المنزل", "العمل"
  governorate String
  city        String?
  area        String?
  street      String
  building    String?
  floor       String?
  apartment   String?
  notes       String?
  phone       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTPRequest {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  purpose     String?   @default("login") // "login" (legacy/dead) | "forgot_password" | "register"
  createdAt   DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, purpose])
}

model OtpAuditLog {
  id        String   @id @default(cuid())
  phone     String
  event     String   // "request" | "verify_success" | "verify_fail"
  ip        String?
  outcome   String?  // e.g. "sent" | "rate_limited" | "locked" | "invalid" | "expired"
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  partnerStockThresholds PartnerStockThreshold[]

  @@index([slug])
  @@index([sortOrder])
}

model Product {
  id                  String   @id @default(cuid())
  categoryId          String
  name                String
  slug                String   @unique
  description         String?
  imageUrl            String?
  tags                String[] @default([]) // for search (Arabic + tags)
  sortOrder           Int      @default(0)
  active              Boolean  @default(true)
  weightGrams         Int?     // for shipping calculation
  basePricePiastres   Int?     // list price (optional)
  discountPricePiastres Int?   // sale price (optional); variant price overrides when set
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants Variant[]
  variantImages VariantImage[]
  partnerStockThresholds PartnerStockThreshold[]

  @@index([categoryId])
  @@index([slug])
  @@index([active])
}

// A colour's photo gallery for the PDP (backlog: multi-image-per-variant, 2026-09-12). Grouped by
// `colorKey` (`${colorName ?? ""}|${colorHex ?? ""}`, the same key `hooks/use-variant-selection.ts`
// already uses to group size rows into one colour) rather than by an individual Variant row, since
// one colour is several Variant rows today (one per size) and should not repeat its photos per size.
// Additive: Variant.imageUrl is untouched and stays the single representative image used on cards,
// in the cart, and as the fallback gallery for any colour with no VariantImage rows yet.
model VariantImage {
  id        String   @id @default(cuid())
  productId String
  colorKey  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, colorKey, sortOrder])
}

model Variant {
  id                  String   @id @default(cuid())
  productId           String
  sku                 String   @unique
  slug                String?  @unique // productSlug_size_colorHexCode for URL (e.g. cotton-tshirt_m_000000)
  name                String   // size e.g. "S", "M", "L", "XL", "XXL"
  colorHex            String?  // optional color hex e.g. "#000000"
  colorName           String?  // optional color name e.g. "أسود"
  imageUrl            String?  // optional image for this color variant; used on product page when selected
  basePricePiastres   Int?     // original price; null = use product's
  pricePiastres       Int      // selling/discounted price in piastres
  stockAvailable      Int      @default(0)
  stockReserved       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]
  partnerInventories PartnerInventory[]
  inventoryLedgerEntries InventoryLedger[]
  restockRequestItems RestockRequestItem[]
  stockReceiptLines StockReceiptLine[]

  @@index([productId])
  @@index([sku])
  @@index([stockAvailable])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id         String    @id @default(cuid())
  userId     String?
  guestToken String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    CartItem[]
  // One of userId or guestToken should be set

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // "PERCENT" | "FIXED" | "BOGO_QTY"
  discountValue Int      // percent 1-100 or piastres; unused (0) for BOGO_QTY
  /// For BOGO_QTY: paid units per cycle (e.g. 2 in "buy 2 get 1 free")
  bogoPayQuantity       Int?
  /// For BOGO_QTY: free units per cycle (e.g. 1)
  bogoFreeQuantity      Int?
  /// When true, BOGO groups units per variant only; when false, pools all cart lines
  bogoSameVariantOnly   Boolean  @default(true)
  showPromotionPopup    Boolean  @default(false)
  promotionPopupMessage String?  @db.Text
  minOrderPiastres Int?  @default(0)
  maxUses       Int?
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([active, validFrom, validUntil])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String?  // set when order is placed
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@index([usedAt])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingRule {
  id         String   @id @default(cuid())
  provider   String
  governorate String
  city       String?  // optional: more specific
  area       String?  // optional: most specific
  weightMin  Int      // grams
  weightMax  Int      // grams
  feePiastres Int     // shipping fee in piastres
  priority   Int      @default(0) // higher = more specific match preferred
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([governorate, city, area])
  @@index([provider, active])
  @@index([priority])
}

// ---------------------------------------------------------------------------
// Orders (with snapshots)
// ---------------------------------------------------------------------------

model Order {
  id                    String       @id @default(cuid())
  userId                String
  status                OrderStatus  @default(CREATED)
  subtotalPiastres      Int
  discountPiastres      Int          @default(0)   // coupon discount
  seniorFreeValuePiastres Int        @default(0)   // senior buy-2-get-1-free value
  shippingPiastres        Int          @default(0) // customer-facing (carrier + shop surcharges)
  carrierShippingPiastres Int          @default(0) // Wasalha only; courier/partner messages
  codFeePiastres          Int          @default(0)
  totalPiastres         Int
  shippingAddress       Json         // governorate, city, area, street, building, floor, apartment, notes, phone
  shippingProvider      String       // Phase 1: "Egypt Post" only
  paymentMethod         String       // "COD" | "PAYMOB" | "INSTAPAY_PREPAID"
  couponCode            String?
  reservationExpiresAt  DateTime?    // legacy; unused (admin decides, no auto-expiry)
  cancellationReason   String?      // e.g. "admin" when cancelled manually
  adminNotes            String?      // internal admin notes (not customer shipping notes)
  exportedToCourierAt   DateTime?    // set when order is included in a courier export (prevents duplicate export)
  assignedPartnerId      String?
  shippingOriginGovernorate String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedPartner Partner?        @relation("OrderAssignedPartner", fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  paymentAttempts PaymentAttempt[]
  routedOrder    RoutedOrder?
  ticket         OrderTicket?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reservationExpiresAt])
  @@index([status, createdAt])
  @@index([status, exportedToCourierAt, createdAt])
  @@index([paymentMethod])
  @@index([shippingProvider])
  @@index([assignedPartnerId])
  @@index([shippingOriginGovernorate])
}

// ---------------------------------------------------------------------------
// Order tickets (backlog 6.5a) — "سؤال عن الطلب" is an in-site ticket, not a WhatsApp link
// (04-decisions.md 2026-09-13 "Account canvas round 2"). One thread per order
// (`@@unique([orderId])`): a second question on the same order is a reply, not a new ticket.
// ---------------------------------------------------------------------------
enum OrderTicketSubject {
  DELIVERY_DELAY
  ADDRESS_CHANGE
}

enum OrderTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketAuthor {
  CUSTOMER
  ADMIN
}

model OrderTicket {
  id            String            @id @default(cuid())
  orderId       String            @unique
  userId        String
  subject       OrderTicketSubject
  status        OrderTicketStatus @default(OPEN)
  contactPhone  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  closedAt      DateTime?

  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages OrderTicketMessage[]

  @@index([userId])
  @@index([status])
}

model OrderTicketMessage {
  id            String       @id @default(cuid())
  ticketId      String
  authorRole    TicketAuthor
  authorUserId  String
  body          String
  createdAt     DateTime     @default(now())

  ticket OrderTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// Audit trail for order lifecycle (create, confirm, cancel, etc.)
model OrderAuditLog {
  id          String   @id @default(cuid())
  orderId     String
  event       String   // "created" | "confirmed" | "cancelled" | "status_change"
  statusFrom  String?
  statusTo    String?
  details     Json?    // e.g. { cancellationReason }
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  variantId       String
  // Snapshots at order time
  productName     String
  variantName     String
  sku             String
  quantity        Int
  unitPricePiastres Int
  totalPiastres   Int
  createdAt       DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@index([orderId, variantId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model PaymentAttempt {
  id            String        @id @default(cuid())
  orderId       String
  status        PaymentStatus @default(PENDING)
  amountPiastres Int
  provider      String
  providerRef   String?       // external transaction id
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerRef])
}

// ---------------------------------------------------------------------------
// Analytics (optional MVP)
// ---------------------------------------------------------------------------

model ViewLog {
  id         String   @id @default(cuid())
  productId  String?
  variantId  String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model AddToCartLog {
  id         String   @id @default(cuid())
  variantId  String
  quantity   Int
  sessionId  String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Partner registration (agents & distributors)
// ---------------------------------------------------------------------------

enum PartnerRequestType {
  AGENT
  DISTRIBUTOR
}

enum PartnerRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

enum PartnerType {
  AGENT
  DISTRIBUTOR
}

model PartnerRequest {
  id           String               @id @default(cuid())
  requestType  PartnerRequestType
  name         String
  governorate  String
  phone        String
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?
  websiteUrl   String?
  otherUrl     String?
  status       PartnerRequestStatus @default(PENDING)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model Partner {
  id            String      @id @default(cuid())
  userId        String?     @unique
  partnerType   PartnerType
  name          String
  governorate   String
  phone         String
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  websiteUrl    String?
  otherUrl      String?
  linkedAgentId String?
  isActive      Boolean     @default(true)
  notes         String?
  // Partner portal foundation (backlog 4.16) — per-partner low-stock threshold (user decision
  // 2026-09-12: default 5, replaces the previously hardcoded `<= 3` checks across home/bell/
  // products colouring/stock report) and the alerts-read watermark for the computed, table-less
  // in-app alert feed (backlog 4.17).
  lowStockThreshold Int      @default(5)
  alertsSeenAt      DateTime?
  // Partner portal v2 foundation (backlog 5.1) — working profile, thresholds, alerts,
  // service areas and the factory settlement rate. All additive, all read by
  // `lib/partner/*` helpers rather than compared to directly (05-partner-portal-v2.md §6).
  workingDays       String[] @default(["SAT", "SUN", "MON", "TUE", "WED", "THU", "FRI"])
  dailyOrderCapacity Int?
  confirmSlaHours   Int      @default(24)
  shipSlaHours      Int      @default(48)
  handoverMethod    HandoverMethod @default(COURIER)
  serviceAreas      Json?
  alertPrefs        Json?
  // The partner's buying rate in basis points (7500 = 75%) — admin-write only
  // (`04-decisions.md`/backlog rule 18: "a partner API that accepts it is a defect").
  costRateBps       Int      @default(7500)
  // Reports platform (backlog 5.6a) — inventory report settings. `deadStockDays`: no sale in
  // N days marks a SKU "dead". `targetCoverDays`: the reorder formula's target cover.
  deadStockDays     Int      @default(60)
  targetCoverDays   Int      @default(21)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedAgent    Partner?   @relation("AgentDistributors", fields: [linkedAgentId], references: [id], onDelete: SetNull)
  distributors   Partner[]  @relation("AgentDistributors")
  rulePartners   ReroutingRulePartner[]
  routedOrdersAsPartner RoutedOrder[] @relation("RoutedOrderPartner")
  assignedOrders Order[] @relation("OrderAssignedPartner")
  lastAssignedInRules   ReroutingRule[] @relation("ReroutingRuleLastPartner")
  inventories PartnerInventory[]
  inventoryLedgerEntries InventoryLedger[]
  sourceRestockRequests RestockRequest[] @relation("RestockRequestSourcePartner")
  destinationRestockRequests RestockRequest[] @relation("RestockRequestDestinationPartner")
  stockReceipts StockReceipt[]
  stockThresholds PartnerStockThreshold[]
  payments      PartnerPayment[]
  stockSnapshots PartnerStockSnapshot[]

  @@index([userId])
  @@index([phone])
  @@index([partnerType])
  @@index([linkedAgentId])
  @@index([isActive])
  @@index([governorate])
}

enum HandoverMethod {
  COURIER
  PICKUP
  OWN_DELIVERY
}

enum PartnerPaymentKind {
  DOWN_PAYMENT
  INSTALLMENT
}

// Per-category / per-product low-stock threshold override (backlog 5.1). Resolution
// order product -> category -> Partner.lowStockThreshold, via lib/partner/resolve-threshold.ts's
// `resolveThreshold(partnerId)` — no screen compares against `Partner.lowStockThreshold` directly.
model PartnerStockThreshold {
  id         String   @id @default(cuid())
  partnerId  String
  categoryId String?
  productId  String?
  threshold  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([partnerId, categoryId])
  @@unique([partnerId, productId])
  @@index([partnerId])
}

// Admin-recorded settlement payments against factory receipts (backlog 5.1 — wholesale
// settlement model, 05-partner-portal-v2.md §1). Written only by
// `POST /api/admin/partners/[id]/payments` (requireAdmin); partners read it.
model PartnerPayment {
  id               String             @id @default(cuid())
  partnerId        String
  kind             PartnerPaymentKind
  amountPiastres   Int
  paidAt           DateTime
  stockReceiptId   String?
  dueAt            DateTime?
  reference        String?
  notes            String?
  recordedByUserId String
  createdAt        DateTime           @default(now())

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  stockReceipt StockReceipt? @relation(fields: [stockReceiptId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([stockReceiptId])
  @@index([paidAt])
}

// Daily stock snapshot (backlog 7.5, `05-partner-portal-v2.md`) — one row per partner per
// day, written by the `/api/cron/stock-snapshot` job so the inventory report's point-in-time
// headline tiles ("قابل للبيع", "القيمة بالتكلفة", ...) get a real previous-period
// comparison instead of none. Aggregated per partner, never per SKU (cost ruling,
// backlog 7.5: Neon free tier is 0.5 GB; per-SKU rows would burn it in a year). Pruned by
// the same job past 400 days.
model PartnerStockSnapshot {
  id                String   @id @default(cuid())
  partnerId         String
  day               DateTime @db.Date
  sellableUnits     Int
  reservedUnits     Int
  valuationPiastres BigInt
  coverDays         Float?
  deadStockSkus     Int
  outOfStockSkus    Int
  createdAt         DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, day])
  @@index([partnerId])
  @@index([day])
}

// ---------------------------------------------------------------------------
// Partner-owned inventory and restock requests
// ---------------------------------------------------------------------------

enum InventoryLedgerReason {
  MANUAL_ADJUSTMENT
  ORDER_RESERVE
  ORDER_COMMIT
  ORDER_RELEASE
  ORDER_RESTORE
  TRANSFER_IN
  TRANSFER_OUT
  RESTOCK_REQUEST_CREATE
  RESTOCK_REQUEST_FULFILL
  LEGACY_BACKFILL
  // Factory intake / import-export source-of-truth (backlog 4.23)
  FACTORY_RECEIPT
  STOCK_COUNT
}

model PartnerInventory {
  id             String   @id @default(cuid())
  partnerId      String
  variantId      String
  stockAvailable Int      @default(0)
  stockReserved  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([partnerId, variantId])
  @@index([partnerId])
  @@index([variantId])
  @@index([stockAvailable])
}

model InventoryLedger {
  id                 String                @id @default(cuid())
  partnerId          String
  variantId          String
  reason             InventoryLedgerReason
  quantityAvailableDelta Int              @default(0)
  quantityReservedDelta  Int              @default(0)
  orderId            String?
  routedOrderId      String?
  restockRequestId   String?
  stockReceiptId     String?
  notes              String?
  createdAt          DateTime              @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockReceipt StockReceipt? @relation(fields: [stockReceiptId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([variantId])
  @@index([orderId])
  @@index([routedOrderId])
  @@index([restockRequestId])
  @@index([stockReceiptId])
  @@index([reason])
  @@index([createdAt])
}

enum RestockRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model RestockRequest {
  id                   String               @id @default(cuid())
  sourcePartnerId      String
  destinationPartnerId String
  status               RestockRequestStatus @default(PENDING)
  notes                String?
  responseNotes        String?
  requestedAt          DateTime             @default(now())
  approvedAt           DateTime?
  rejectedAt           DateTime?
  fulfilledAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  sourcePartner Partner @relation("RestockRequestSourcePartner", fields: [sourcePartnerId], references: [id], onDelete: Restrict)
  destinationPartner Partner @relation("RestockRequestDestinationPartner", fields: [destinationPartnerId], references: [id], onDelete: Restrict)
  items RestockRequestItem[]

  @@index([sourcePartnerId])
  @@index([destinationPartnerId])
  @@index([status])
  @@index([createdAt])
}

model RestockRequestItem {
  id               String @id @default(cuid())
  restockRequestId String
  variantId        String
  quantity         Int

  restockRequest RestockRequest @relation(fields: [restockRequestId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([restockRequestId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Factory intake / stock-count receipts (backlog 4.23 — source of truth between
// partner and factory; schema landed in 4.16 so no later task touches schema.prisma)
// ---------------------------------------------------------------------------

enum StockReceiptKind {
  FACTORY
  COUNT
}

model StockReceipt {
  id        String           @id @default(cuid())
  partnerId String
  kind      StockReceiptKind
  reference String?
  notes     String?
  // Settlement (backlog 5.1) — sum of the FACTORY lines' `unitCostPiastres * quantity`,
  // snapshotted at apply time from the partner's rate at that moment. Null for COUNT
  // receipts (a count is a correction, not a purchase).
  totalCostPiastres Int?
  createdAt DateTime         @default(now())

  partner Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lines   StockReceiptLine[]
  ledgerEntries InventoryLedger[]
  payments PartnerPayment[]

  @@index([partnerId])
  @@index([kind])
  @@index([createdAt])
}

model StockReceiptLine {
  id                String   @id @default(cuid())
  receiptId         String
  variantId         String
  quantity          Int
  previousAvailable Int
  newAvailable      Int
  // Settlement (backlog 5.1) — `round(pricePiastres * partner.costRateBps / 10000)` snapshotted
  // at apply time for FACTORY lines; null for COUNT lines (never recomputed later, so a
  // rate change never rewrites history — 05-partner-portal-v2.md §1 "Settlement model").
  unitCostPiastres  Int?

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Governorate rerouting (orders → partners by governorate + round-robin)
// ---------------------------------------------------------------------------

model ReroutingRule {
  id                   String    @id @default(cuid())
  governorate          String    @unique
  isActive             Boolean   @default(true)
  lastAssignedPartnerId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lastAssignedPartner Partner?  @relation("ReroutingRuleLastPartner", fields: [lastAssignedPartnerId], references: [id], onDelete: SetNull)
  partners            ReroutingRulePartner[]
  routedOrders        RoutedOrder[]

  @@index([governorate])
  @@index([isActive])
}

model ReroutingRulePartner {
  id        String   @id @default(cuid())
  ruleId    String
  partnerId String
  isActive  Boolean  @default(true)
  priority  Int?     // lower = earlier in round-robin; null = use createdAt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule    ReroutingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  partner Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([ruleId, partnerId])
  @@index([ruleId])
  @@index([partnerId])
}

enum RoutedOrderStatus {
  ASSIGNED
  NOTIFIED
  ACCEPTED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  UNROUTED
}

enum AssignmentMode {
  AUTO
  MANUAL
}

model RoutedOrder {
  id                  String            @id @default(cuid())
  orderId             String            @unique
  governorate          String
  ruleId              String?
  partnerId            String?
  assignmentSequence  Int               @default(0)
  assignmentMode      AssignmentMode    @default(AUTO)
  status              RoutedOrderStatus  @default(ASSIGNED)
  notifiedAt          DateTime?
  assignedAt          DateTime          @default(now())
  acceptedAt          DateTime?
  deliveredAt         DateTime?
  proofImageUrl       String?
  proofImagePublicId  String?
  notes               String?
  notificationError   String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rule    ReroutingRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  partner Partner? @relation("RoutedOrderPartner", fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([governorate])
  @@index([ruleId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}
