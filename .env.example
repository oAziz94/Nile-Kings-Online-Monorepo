# Neon Postgres (use pooled URL for app, direct for migrations)
# Get from Neon dashboard: Connect -> Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# For migrations use direct (non-pooled) connection
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Optional: increase migrate lock timeout (ms) if P1002 on Neon e.g. MIGRATE_LOCK_TIMEOUT=30000

# Upstash Redis (rate limiting, cooldown, lock)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+1234567890"

# Auth (min 16 chars)
JWT_SECRET="your-secret-at-least-16-chars"

# Senior verification: AES-256 key as 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Cron: protect job routes (e.g. release-expired-reservations). Set in Vercel env and pass as query ?secret= or header x-cron-secret
CRON_SECRET=""

# Cloudinary (admin product images). Optional; upload API returns 501 if not set
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
