# Template for local dev against the `redesign` Neon database branch.
# Copy this file to `.env.redesign` (gitignored — never commit real values) and fill in
# the two connection strings from the Neon console for the `redesign` branch.
#
# Everything else (Redis, WaPilot, Cloudinary, etc.) is shared with `.env` and does not
# need to be repeated here unless you specifically want a separate value for redesign work.
#
# Usage: npm run dev:redesign / npm run db:push:redesign / npm run db:migrate:redesign
# (never `npm run dev` / `npm run db:push` while working on redesign — those read `.env`,
# which still points at the production database)

# Neon console -> your project -> Branches -> "redesign" -> Connection Details
# "Pooled connection" string:
DATABASE_URL=""
# "Direct connection" string (no "-pooler" in the hostname) - used for migrations:
DIRECT_URL=""
