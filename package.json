{
  "name": "nile-kings-online",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "backfill:partner-requests-emails": "tsx scripts/backfill-partner-request-emails.ts",
    "inventory:audit": "tsx scripts/inventory-audit.ts",
    "inventory:rebuild-reserved": "tsx scripts/inventory-rebuild-reserved.ts",
    "partner-inventory:backfill-gamal": "tsx scripts/backfill-gamal-partner-inventory.ts",
    "partner-inventory:verify-gamal": "tsx scripts/verify-gamal-partner-inventory.ts",
    "inventory:dashboard": "tsx tools/inventory-dashboard/server.ts",
    "version:task": "npm version patch -m \"chore(version): %s (task)\"",
    "version:feature": "npm version minor -m \"chore(version): %s (major feature)\"",
    "dev:redesign": "dotenv -e .env.redesign -- next dev --turbopack",
    "db:push:redesign": "dotenv -e .env.redesign -- prisma db push",
    "db:migrate:redesign": "dotenv -e .env.redesign -- prisma migrate dev",
    "db:studio:redesign": "dotenv -e .env.redesign -- prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jose": "^6.1.3",
    "libphonenumber-js": "^1.13.7",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "nodemailer": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.10.0",
    "tailwind-merge": "^2.5.0",
    "twilio": "^5.12.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
